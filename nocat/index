<script>
  const field = document.getElementById('starfield');
  const count = window.innerWidth < 780 ? 40 : 80;
  const frag = document.createDocumentFragment();
  for(let i=0;i<count;i++){
    const s = document.createElement('div');
    s.className = 'star';
    s.style.left = Math.random()*100 + 'vw';
    s.style.top = Math.random()*100 + 'vh';
    s.style.animationDelay = (Math.random()*4) + 's';
    s.style.width = s.style.height = (Math.random() < 0.15 ? '3px' : '2px');
    frag.appendChild(s);
  }
  field.appendChild(frag);
</script>

<script>
(function(){
  var KEY = 'nocat-site-lang';
  function apply(lang){
    document.querySelectorAll('.lang-ko').forEach(function(el){ el.hidden = (lang !== 'ko'); });
    document.querySelectorAll('.lang-en').forEach(function(el){ el.hidden = (lang !== 'en'); });
    document.querySelectorAll('[data-lang-btn]').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-lang-btn') === lang);
    });
    document.documentElement.lang = lang;
  }
  var saved = localStorage.getItem(KEY) || 'ko';
  apply(saved);
  document.querySelectorAll('[data-lang-btn]').forEach(function(b){
    b.addEventListener('click', function(){
      var lang = b.getAttribute('data-lang-btn');
      localStorage.setItem(KEY, lang);
      apply(lang);
    });
  });
})();
</script>

</body>
</html>
