<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* 국문: 로고 서체 Sora와 같은 기하학적 형태의 G마켓 산스 */
  @font-face{ font-family:'GmarketSans'; font-weight:300; font-style:normal; font-display:swap;
    src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansLight.woff') format('woff'); }
  @font-face{ font-family:'GmarketSans'; font-weight:500; font-style:normal; font-display:swap;
    src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansMedium.woff') format('woff'); }
  @font-face{ font-family:'GmarketSans'; font-weight:700; font-style:normal; font-display:swap;
    src:url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_2001@1.1/GmarketSansBold.woff') format('woff'); }
  :root{
    --bg: #0E1424;
    --bg-panel: #151C34;
    --line: rgba(237,239,246,0.09);
    --text: #EDEFF6;
    --text-dim: #9AA3C0;
    --text-dimmer: #6B7396;
    --gold: #DCA75A;
    --nocat: #F0A4C4;
    --nocat-soft: rgba(240,164,196,0.14);
    --serif: 'Sora', 'GmarketSans', sans-serif;
    --sans: 'Sora', 'GmarketSans', sans-serif;
    --brand: 'Sora', 'GmarketSans', sans-serif;
    --mono: 'Sora', 'GmarketSans', sans-serif;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }

  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  a{ color:inherit; }
  :focus-visible{ outline:2px solid var(--nocat); outline-offset:3px; }

  .wrap{ max-width:920px; margin:0 auto; padding:0 28px; }

  .starfield{
    position:fixed; inset:0; z-index:-1; pointer-events:none;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(240,164,196,0.12), transparent 60%),
      var(--bg);
  }
  .star{
    position:absolute; width:2px; height:2px; border-radius:50%;
    background:var(--text); opacity:0.5;
    animation: twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle{
    0%,100%{ opacity:0.15; }
    50%{ opacity:0.85; }
  }

  header.nav{
    position:sticky; top:0; z-index:20;
    backdrop-filter: blur(10px);
    background:rgba(14,20,36,0.72);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    height:64px; padding:0 28px; gap:16px;
  }
  .brand{ display:flex; align-items:center; gap:10px; font-family:var(--brand); font-weight:600; font-size:18px; letter-spacing:-0.01em; text-decoration:none; color:inherit; flex-shrink:0; white-space:nowrap; }
  .brand-mark{ width:32px; height:32px; flex-shrink:0; display:block; }
  .nav-right{ display:flex; align-items:center; gap:16px; }
  nav.links{ display:flex; gap:22px; font-family:var(--mono); font-size:13px; color:var(--text-dim); }
  nav.links a{ text-decoration:none; transition:color 0.2s; }
  nav.links a:hover{ color:var(--nocat); }

  .lang-toggle{
    display:flex; gap:3px; background:var(--bg-panel); border:1px solid var(--line);
    border-radius:999px; padding:3px; flex-shrink:0;
  }
  .lang-toggle button{
    font-family:var(--mono); font-size:11.5px; padding:6px 12px; border-radius:999px;
    border:none; background:transparent; color:var(--text-dimmer); cursor:pointer;
    transition:background 0.2s, color 0.2s;
  }
  .lang-toggle button.active{ background:var(--nocat); color:#1B1408; }

  .hero{
    padding:96px 0 70px;
    text-align:center;
    border-bottom:1px solid var(--line);
  }
  .eyebrow{
    font-family:var(--mono); font-size:13px; letter-spacing:0.14em;
    color:var(--nocat); text-transform:uppercase; margin-bottom:22px;
  }
  h1.title{
    font-family:var(--serif); font-weight:600;
    font-size:clamp(44px, 8vw, 76px);
    letter-spacing:-0.01em;
    line-height:1;
  }
  .tagline-en{
    margin-top:18px; font-family:var(--mono); font-size:13px; letter-spacing:0.16em;
    color:var(--text-dimmer); text-transform:uppercase;
  }
  .lede{
    max-width:560px; margin:30px auto 0;
    font-size:17.5px; color:var(--text-dim);
  }
  .hero-cta{ margin-top:40px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
  .store-btn{
    display:flex; align-items:center; gap:10px;
    padding:12px 22px; border-radius:12px;
    border:1px solid var(--line); background:var(--bg-panel);
    text-decoration:none; transition:border-color 0.2s, transform 0.2s;
  }
  .store-btn:hover{ border-color:var(--nocat); transform:translateY(-2px); }
  .store-btn .store-kind{ font-family:var(--mono); font-size:10.5px; color:var(--text-dimmer); display:block; }
  .store-btn .store-name{ font-family:var(--sans); font-size:14.5px; font-weight:600; }
  .store-btn.disabled{ opacity:0.45; pointer-events:none; }

  section{ padding:80px 0; border-bottom:1px solid var(--line); }
  .section-eyebrow{
    font-family:var(--mono); font-size:12px; letter-spacing:0.14em;
    color:var(--text-dimmer); text-transform:uppercase; margin-bottom:14px; text-align:center;
  }
  h2.section-title{
    font-family:var(--serif); font-weight:500; font-size:clamp(26px,4vw,34px);
    text-align:center; margin-bottom:52px;
  }

  .features-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:22px;
  }
  .feature{
    background:var(--bg-panel); border:1px solid var(--line); border-radius:16px;
    padding:28px 24px;
    transition:border-color 0.25s, transform 0.25s;
  }
  .feature:hover{ border-color:var(--nocat); transform:translateY(-4px); }
  .feature-icon{
    width:38px; height:38px; border-radius:10px; background:var(--nocat-soft);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--mono); font-size:16px; color:var(--nocat); margin-bottom:16px;
  }
  .feature-name{ font-family:var(--serif); font-size:18.5px; font-weight:500; margin-bottom:8px; }
  .feature-desc{ color:var(--text-dim); font-size:14px; }

  .lang-row{
    display:flex; justify-content:center; gap:14px; flex-wrap:wrap; margin-top:44px;
  }
  .lang-pill{
    font-family:var(--mono); font-size:12.5px; color:var(--text-dim);
    border:1px solid var(--line); border-radius:999px; padding:8px 18px;
  }

  .cta-band{ text-align:center; border-bottom:none; }
  .cta-band h2.section-title{ margin-bottom:28px; }
  .cta-note{
    margin-top:22px; font-family:var(--mono); font-size:12.5px; color:var(--text-dimmer);
  }

  footer{ padding:60px 0 44px; border-top:1px solid var(--line); }
  .footer-inner{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; }
  .footer-brand{ font-family:var(--brand); font-weight:600; letter-spacing:-0.01em; font-size:16px; color:var(--text-dim); }
  .footer-links{ display:flex; flex-wrap:wrap; gap:10px 24px; font-family:var(--mono); font-size:13px; color:var(--text-dimmer); }
  .footer-links a{ color:inherit; text-decoration:none; white-space:nowrap; transition:color 0.2s; }
  .footer-links a:hover{ color:var(--nocat); }
  .footer-copy{ margin-top:26px; font-family:var(--mono); font-size:12px; color:var(--text-dimmer); }
  .biz-info{
    margin-top:34px; padding-top:24px; border-top:1px solid var(--line);
    display:flex; flex-wrap:wrap; gap:8px 18px;
    font-family:var(--sans); font-size:12.5px; color:var(--text-dimmer); line-height:1.7;
  }
  .biz-info a{ color:var(--text-dimmer); text-decoration:underline; text-underline-offset:2px; }
  .biz-info a:hover{ color:var(--nocat); }
  /* 푸터는 홈과 같은 폭으로 */
  .footer-wrap{ max-width:1080px; }

  @media (max-width: 780px){
    .features-grid{ grid-template-columns:1fr; }
    nav.links{ display:none; }
  }
  @media (max-width: 600px){
    .hero{ padding:64px 0 50px; }
  }

  /* 상단 바: 모든 페이지 공통 · 화면 폭에 따라 단계적으로 축소 */
  @media (max-width: 780px){
    .nav-inner{ height:58px; padding:0 20px; gap:12px; }
    .brand{ font-size:17px; gap:9px; }
    .brand-mark{ width:30px; height:30px; }
  }
  @media (max-width: 480px){
    .nav-inner{ height:54px; padding:0 16px; gap:10px; }
    .nav-right{ gap:10px; }
    .brand{ font-size:16px; gap:8px; }
    .brand-mark{ width:28px; height:28px; }
    .back-link{ font-size:12px; }
    .lang-toggle button{ font-size:11px; padding:5px 10px; }
  }
  @media (max-width: 360px){
    .back-link{ display:none; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; }
  }
</style>
