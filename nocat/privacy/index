<script>
(function(){
  var KEY = 'nocat-site-lang';
  function apply(lang){
    document.querySelectorAll('.lang-ko').forEach(function(el){ el.hidden = (lang !== 'ko'); });
    document.querySelectorAll('.lang-en').forEach(function(el){ el.hidden = (lang !== 'en'); });
    document.querySelectorAll('[data-lang-btn]').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-lang-btn') === lang);
    });
    document.documentElement.lang = lang;
  }
  var hash = (location.hash || '').replace('#', '');
  var saved = 'ko';
  try { saved = localStorage.getItem(KEY) || 'ko'; } catch (e) {}
  if (hash === 'en' || hash === 'ko') saved = hash;
  apply(saved);
  document.querySelectorAll('[data-lang-btn]').forEach(function(b){
    b.addEventListener('click', function(){
      var lang = b.getAttribute('data-lang-btn');
      try { localStorage.setItem(KEY, lang); } catch (e) {}
      apply(lang);
    });
  });
})();
</script>

