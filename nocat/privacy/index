  .summary li::before{
    content:""; position:absolute; left:0; top:0.72em; width:5px; height:5px;
    border-radius:50%; background:var(--nocat);
  }

  .table-wrap{ margin:14px 0 14px; border:1px solid var(--line); border-radius:14px; overflow:hidden; }
  .ptable{ width:100%; border-collapse:collapse; font-size:13.5px; line-height:1.6; }
  .ptable th, .ptable td{ padding:12px 14px; text-align:left; vertical-align:top; overflow-wrap:anywhere; }
  .ptable th{
    font-weight:500; font-size:12px; letter-spacing:0.06em; color:var(--text-dimmer);
