    .table-wrap{ border:none; border-radius:0; overflow:visible; }
    .ptable thead{ display:none; }
    .ptable, .ptable tbody, .ptable tr, .ptable td{ display:block; width:100%; }
    .ptable tr{
      border:1px solid var(--line); border-radius:12px; background:var(--bg-panel);
      padding:12px 16px; margin-bottom:10px;
    }
    .ptable td{ border:none; padding:4px 0; }
    .ptable td:first-child{ white-space:normal; font-size:15px; padding-bottom:6px; }
    .ptable td:not(:first-child)::before{
      content:attr(data-label); display:block; font-size:11.5px; color:var(--text-dimmer);
      letter-spacing:0.04em; margin-bottom:1px;
    }
    .contact-label{ display:block; min-width:0; }
