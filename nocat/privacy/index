  .footer-wrap{ max-width:1080px; }

  .policy h2{ scroll-margin-top:80px; }
  .policy .intro{ font-size:16px; color:var(--text); max-width:none; margin-bottom:26px; }
  .policy p, .policy li{ max-width:none; }
  .policy p + p{ margin-top:10px; }
  .policy .prev{ margin-top:14px; font-size:13px; color:var(--text-dimmer); }
  .policy strong{ color:var(--text); font-weight:500; }

  .summary{
    background:var(--bg-panel); border:1px solid var(--line); border-radius:16px;
