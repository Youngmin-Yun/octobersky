  .ptable td{ color:var(--text-dim); border-bottom:1px solid var(--line); }
  .ptable tr:last-child td{ border-bottom:none; }
  .ptable td:first-child{ color:var(--text); font-weight:500; white-space:nowrap; }

  .notice{
    margin:16px 0 0; padding:14px 18px; border-radius:12px; font-size:14px; color:var(--text-dim);
